# LINE Bot
LINE_CHANNEL_SECRET=your_line_channel_secret
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token

# Gemini API
GEMINI_API_KEY=your_gemini_api_key

# Google Service Account（執行 scripts/setup_service_account.sh 一次性設定）
GOOGLE_SERVICE_ACCOUNT_JSON=your_service_account_json_string
GOOGLE_CALENDAR_ID=your_shared_calendar_id@example.com

# Encryption
ENCRYPTION_KEY=base64_encoded_32_byte_key

# GCP
GCP_PROJECT_ID=your_gcp_project_id

# Internal endpoints（Cloud Scheduler 用）
NOTIFY_SECRET=your_internal_secret
